# ===== Custom Suricata rules - Wamba José =====
# 1. Recon: ICMP ping sweep (T1018)
alert icmp any any -> $HOME_NET any (msg:"LOCAL ICMP Ping to sensor detected"; itype:8; classtype:misc-activity; sid:1000001; rev:1;)
# 2. Recon: Nmap SYN port scan (T1046)
alert tcp any any -> $HOME_NET any (msg:"LOCAL Possible Nmap SYN port scan"; flow:stateless; flags:S,12; threshold:type both, track by_src, count 20, seconds 10; classtype:attempted-recon; sid:1000002; rev:1;)
# 3. Recon: Nmap Scripting Engine HTTP probe (T1595)
alert http any any -> $HOME_NET any (msg:"LOCAL Nmap Scripting Engine HTTP User-Agent"; flow:established,to_server; http.user_agent; content:"Nmap Scripting Engine"; nocase; classtype:web-application-attack; sid:1000003; rev:1;)
# 4. Credential access: SSH brute force (T1110)
alert tcp any any -> $HOME_NET 22 (msg:"LOCAL Possible SSH brute force"; flow:stateless; flags:S,12; threshold:type both, track by_src, count 5, seconds 60; classtype:attempted-admin; sid:1000004; rev:1;)
# 5. Recon: Nikto web vulnerability scanner (T1595.002)
alert http any any -> $HOME_NET any (msg:"LOCAL Nikto web scanner detected"; flow:established,to_server; http.user_agent; content:"Nikto"; nocase; threshold:type limit, track by_src, count 1, seconds 60; classtype:web-application-attack; sid:1000005; rev:2;)
# 6. Initial access: SQL injection UNION SELECT (T1190)
alert http any any -> $HOME_NET any (msg:"LOCAL SQL injection attempt UNION SELECT"; flow:established,to_server; http.uri; content:"union"; nocase; content:"select"; nocase; distance:0; classtype:web-application-attack; sid:1000006; rev:1;)
# 7. C2: DNS query to suspicious .xyz domain (T1071.004)
alert dns any any -> any any (msg:"LOCAL DNS query for suspicious .xyz domain"; dns.query; content:".xyz"; nocase; endswith; classtype:bad-unknown; sid:1000007; rev:1;)
# 8. Malware delivery: EICAR test file over HTTP (T1105)
alert http any any -> $HOME_NET any (msg:"LOCAL EICAR test file downloaded over HTTP"; flow:established,to_client; file.data; content:"EICAR-STANDARD-ANTIVIRUS-TEST-FILE"; classtype:trojan-activity; sid:1000008; rev:1;)
